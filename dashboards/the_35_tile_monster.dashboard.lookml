- dashboard: the_35_tile_monster
  title: "Executive Overview - All KPIs (35 Tiles Bloat)"
  layout: grid
  rows:
    - elements: [metric_tile_1, metric_tile_2, metric_tile_3, metric_tile_4, metric_tile_5, metric_tile_6, metric_tile_7, metric_tile_8, metric_tile_9, metric_tile_10, metric_tile_11, metric_tile_12, metric_tile_13, metric_tile_14, metric_tile_15, metric_tile_16, metric_tile_17, metric_tile_18, metric_tile_19, metric_tile_20, metric_tile_21, metric_tile_22, metric_tile_23, metric_tile_24, metric_tile_25, metric_tile_26, metric_tile_27, metric_tile_28, metric_tile_29, metric_tile_30, metric_tile_31, metric_tile_32, metric_tile_33, metric_tile_34, metric_tile_35]

